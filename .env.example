# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 GitHub에 올라가지 않습니다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 실계좌(실전투자)용 앱키. 키움에서 모의투자 키와 따로 발급받습니다.
# 지금은 Mintory '실계좌 점검'의 잔고 조회와 매일 밤 리허설(주문 없음)에만 쓰고, 주문에는 쓰지 않습니다.
KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_SECRET_KEY=
# 실계좌 리허설: 매일 밤 실계좌 잔고로 낼 주문을 계산만 해서 paper/rehearsal 에 기록 (0이면 끔)
REHEARSAL=1
# 휴대폰 알림(텔레그램). notify_setup.bat 이 자동으로 채워줍니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 매일 밤 요약을 끄려면 0
NOTIFY_DAILY=1
# 미국장 열린 다음 날 아침 7시 장 마감 보고 (0이면 끔)
NOTIFY_CLOSE=1
# 그 주 마지막 거래일 다음 날 아침 주간 리포트 (0이면 끔)
NOTIFY_WEEKLY=1
# 리밸런싱 전날 밤 예상 주문 알림 (0이면 끔)
NOTIFY_PREVIEW=1
# 안전장치. 주문 하나가 이 금액(달러)을 넘으면 그날 주문을 전부 막습니다. 비우면 계좌 전체 금액.
# 실계좌로 바꿀 때는 꼭 채워야 주문이 나갑니다.
MAX_ORDER_USD=
# 계좌가 전날 장 마감보다 이 % 넘게 빠져 있으면 그날 주문을 쉬고 알림을 보냅니다. 0 이면 끔.
MAX_DAILY_LOSS_PCT=10
# 기록 백업을 한 부 더 둘 폴더 (예: C:\Users\이름\OneDrive\Mintory백업). 비우면 프로젝트의 backups 폴더에만.
BACKUP_DIR=
